{
  "name": "@omi-io/errors-core",
  "scopeCommitName": "@:errc",
  "version": "1.0.0",
  "description": "Error handling utilities for general-purpose software development.",
  "license": "MIT",
  "keywords": [
    "errors",
    "error handling",
    "error management",
    "error utilities",
    "error helpers",
